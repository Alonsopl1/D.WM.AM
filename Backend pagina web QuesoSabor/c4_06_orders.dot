digraph G {graph [label="C3 · Componentes de GraphQL privado",labelloc=t,fontname="DejaVu Sans",fontsize=23,bgcolor="white",pad=.35,ranksep=.7];node[shape=box,style="rounded,filled",fontname="DejaVu Sans",fontsize=12,color="#447285",fillcolor="#E8F3F8",margin=".20,.15"];edge[fontname="DejaVu Sans",fontsize=10,color="#526677"];rankdir=LR;
